# ============================================================
# Transaction Rewards API - Environment Variables
# ============================================================
# Copy this file to .env and fill in appropriate values.
# Spring Boot will pick up these values via ${} placeholders
# in application.properties.
# ============================================================

# --- Server ---
SERVER_PORT=8080

# --- Spring Application ---
SPRING_APPLICATION_NAME=Rewards API

# --- Datasource (H2 default; override for MySQL/Postgres) ---
SPRING_DATASOURCE_URL=jdbc:h2:mem:rewardsdb
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# --- JPA / Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# --- H2 Console (disable in production) ---
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console

# --- SQL Init ---
SPRING_SQL_INIT_MODE=always

# --- Actuator ---
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# --- Logging ---
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ASSESSMENT_REWARDS=DEBUG

# --- CORS (comma-separated origins; use * only for dev) ---
CORS_ALLOWED_ORIGINS=*
